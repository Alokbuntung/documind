# DocuMind Environment Variables Template
# ----------------------------------------
# Copy this file to '.env' and fill in the values before running the application

# FLASK CONFIGURATION
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# SECURITY
# Generate a strong key for session encryption (e.g. using `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=your_super_secret_random_key_here

# MYSQL DATABASE CONFIGURATION
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=documind_user
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DB=documind

# TESSERACT OCR CONFIGURATION (Only for Windows or custom path)
# e.g., C:\Program Files\Tesseract-OCR\tesseract.exe
# Leave blank or commented on standard Linux deployments where it's in system PATH
TESSERACT_CMD_PATH=

# OAUTH 2.0 CREDENTIALS (Optional - leave blank if unused)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# SMTP / EMAIL SETTINGS (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_USE_TLS=True
MAIL_DEFAULT_SENDER=noreply@documind.local
